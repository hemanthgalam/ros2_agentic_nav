# Google Gemini API key (https://aistudio.google.com/apikey). Required for /api/chat.
GEMINI_API_KEY=

# Model used for tool-calling. "gemini-flash-latest" is a rolling alias that
# tracks Google's current flash model and supports function calling.
GEMINI_MODEL=gemini-flash-latest

# rosbridge_server websocket endpoint (see ros2_ws/.../launch/sim_bridge.launch.py)
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# Default geodetic datum (overridden at runtime via /api/datum once calibrated
# from the map UI). lat0/lon0 anchor the robot's ENU (map frame) origin.
DATUM_LAT0=37.4275
DATUM_LON0=-122.1697
DATUM_ALT0=0.0
DATUM_HEADING_OFFSET_DEG=0.0

# Geofence: robot may not be sent goals farther than this from the datum.
GEOFENCE_MAX_RADIUS_M=250

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
